{
  "name": "k6-performance-framework",
  "version": "1.0.0",
  "description": "Educational k6 performance testing framework with controlled targets and reproducible reports",
  "type": "module",
  "main": "tests/smoke.test.js",
  "scripts": {
    "test": "npm run test:ci",
    "test:ci": "npm run test:config && npm run test:runtime && npm run test:http-client && npm run test:retry && npm run test:metrics && npm run test:smoke-integrity && npm run test:report-model && npm run test:reporter && npm run test:profile && npm run test:telemetry && npm run test:workload && npm run test:load-ids && npm run test:long-ids && npm run test:scenarios && npm run test:external-policy && npm run test:target-policy && npm run test:pipeline-scripts && npm run test:workflow && npm run test:lab && npm run test:surface",
    "test:config": "k6 run --quiet tests/configuration.test.js && k6 run --quiet -e BASE_URL=https://example.test/ -e EXPECTED_BASE_URL=https://example.test tests/configuration.test.js",
    "test:metrics": "node scripts/run-k6-with-fixture.mjs tests/regression/metric-emission.test.js",
    "test:smoke-integrity": "node scripts/run-k6-with-fixture.mjs tests/regression/smoke-metric-integrity.test.js",
    "test:reporter": "node scripts/run-k6-with-fixture.mjs tests/regression/reporter-thresholds.test.js",
    "test:report-model": "node scripts/run-k6-with-fixture.mjs tests/regression/report-model.test.js",
    "test:workload": "node scripts/run-k6-with-fixture.mjs tests/regression/swapi-workload.test.js",
    "test:load-ids": "node scripts/run-k6-with-fixture.mjs tests/regression/load-valid-ids.test.js",
    "test:long-ids": "node scripts/run-k6-with-fixture.mjs tests/regression/long-scenarios-valid-ids.test.js",
    "test:external-policy": "node scripts/run-k6-with-fixture.mjs tests/regression/external-smoke-policy.test.js",
    "test:target-policy": "node scripts/run-k6-with-fixture.mjs tests/regression/target-policy.test.js",
    "test:workflow": "node tests/ci/workflow-policy.test.mjs",
    "test:pipeline-scripts": "node tests/ci/pipeline-scripts.test.mjs",
    "test:surface": "node tests/ci/source-surface.test.mjs",
    "test:profile": "node scripts/run-k6-with-fixture.mjs tests/regression/run-profile.test.js && k6 run --quiet -e BASE_URL=https://private.example.internal/api -e TARGET_KIND=controlled-remote -e EXPECT_PUBLIC_TARGET_REDACTED=true tests/regression/run-profile.test.js",
    "test:runtime": "node scripts/run-k6-with-fixture.mjs tests/regression/runtime-config.test.js --env REQUEST_TIMEOUT=7s --env MAX_RETRIES=2",
    "test:http-client": "node scripts/run-k6-with-fixture.mjs tests/regression/http-client-options.test.js",
    "test:retry": "node scripts/run-k6-with-fixture.mjs tests/regression/retry-behavior.test.js --env MAX_RETRIES=1",
    "test:telemetry": "node scripts/run-k6-with-fixture.mjs tests/regression/telemetry.test.js --env RUN_ID=contract-run --env HTTP_LOG_SAMPLE_RATE=0 --env LOG_LEVEL=INFO",
    "test:lab": "node tests/ci/lab-contract.test.mjs",
    "test:scenarios": "node scripts/run-k6-with-fixture.mjs tests/regression/scenario-semantics.test.js",
    "lab:up": "node scripts/swapi-lab.mjs up",
    "lab:down": "node scripts/swapi-lab.mjs down",
    "lab:smoke": "node scripts/swapi-lab.mjs run smoke",
    "lab:load": "node scripts/swapi-lab.mjs run load",
    "lab:stress": "node scripts/swapi-lab.mjs run stress",
    "lab:spike": "node scripts/swapi-lab.mjs run spike",
    "lab:soak": "node scripts/swapi-lab.mjs run soak",
    "lab:endurance": "node scripts/swapi-lab.mjs run endurance",
    "lab:breakpoint": "node scripts/swapi-lab.mjs run breakpoint",
    "smoke": "k6 run --env TARGET_KIND=controlled-remote tests/smoke.test.js",
    "load": "k6 run --env TARGET_KIND=controlled-remote tests/load.test.js",
    "stress": "k6 run --env TARGET_KIND=controlled-remote tests/stress.test.js",
    "spike": "k6 run --env TARGET_KIND=controlled-remote tests/spike.test.js",
    "soak": "k6 run --env TARGET_KIND=controlled-remote tests/soak.test.js",
    "external-smoke": "k6 run --env TARGET_KIND=public-cdn --env MAX_RETRIES=0 tests/external-smoke.test.js",
    "smoke:report": "k6 run --env TARGET_KIND=controlled-remote tests/smoke.test.js --out json=reports/smoke-results.json",
    "load:report": "k6 run --env TARGET_KIND=controlled-remote tests/load.test.js --out json=reports/load-results.json",
    "stress:report": "k6 run --env TARGET_KIND=controlled-remote tests/stress.test.js --out json=reports/stress-results.json",
    "all": "npm run smoke && npm run load && npm run stress"
  },
  "keywords": [
    "k6",
    "performance",
    "load-testing",
    "stress-testing",
    "api-testing"
  ],
  "author": "",
  "license": "MIT"
}
